# ─── Copia a .env y rellena. .env NUNCA va a git (ver .gitignore). ───

# ── DB ──
# DEV (Postgres local vía docker-compose):
DATABASE_URL="postgresql://hub:hub@localhost:5432/personal_hub?schema=public"
#
# PROD (Neon + Vercel serverless) — poner estas en el dashboard de Vercel:
#  DATABASE_URL = URL POOLED (host con "-pooler") + flags PgBouncer:
#    postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1
#  DIRECT_URL = URL DIRECTA (host SIN "-pooler"), solo para 'prisma migrate deploy':
#    postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require

# ── API ──
API_PORT=3000
# Origen del frontend permitido por CORS (Vite dev).
WEB_ORIGIN="http://localhost:5173"
# Secret para firmar/derivar (Lucia). Genera uno largo aleatorio en prod.
AUTH_SECRET="cambia-esto-por-un-secreto-largo-aleatorio"
# "development" | "production". Controla cookie Secure flag.
NODE_ENV="development"

# ── IA (AIProvider) ──
# Proveedor por defecto: "ollama" (local, 0 tokens) | "claude" (potente, gasta).
AI_DEFAULT_PROVIDER="ollama"
# Ollama local. Arranca con: ollama run qwen2.5:7b
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
# Claude — solo si usas el provider "claude". Deja vacío si no.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-sonnet-5"

# ── TMDB (imágenes de anime) ──
# Token de lectura v4 (Bearer) de https://www.themoviedb.org/settings/api — gratis.
# Enriquece los resultados de anime con póster + backdrop de TMDB. Vacío = off.
TMDB_READ_TOKEN=""

# ── Frontend (Vite lee sólo VITE_*, inline en build) ──
# DEV: la API está en otro puerto.
VITE_API_URL="http://localhost:3000"
# PROD (Vercel): same-origin, API bajo /api. Pon VITE_API_URL="/api" en Vercel
# (o déjala sin definir: api.ts usa "/api" por defecto).
